# Claude Blocker Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token (from BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Group Chat ID (negative number for groups/supergroups)
# Get this by sending a message in your group and checking:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Server port (default: 8765)
# CLAUDE_BLOCKER_PORT=8765

# Claude command to use (default: claude)
# CLAUDE_COMMAND=claude

# Timing configuration for TUI interactions (in milliseconds)
# Delay before Enter key after typing text (default: 150)
# CLAUDE_INPUT_DELAY_MS=150

# Delay between key sequences (e.g., arrow keys) (default: 100)
# CLAUDE_KEY_DELAY_MS=100
